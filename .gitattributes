# Check out text files with LF line endings on all platforms (including
# Windows): licence notices are embedded into binaries and compared against
# xtask output, and tests/builds expect identical bytes everywhere. Both
# rc.exe and the Windows manifest parser accept LF.
* text=auto eol=lf

# cargo-about copies upstream crate licence files verbatim (some with CRLF
# endings), and `cargo xtask licenses --check` compares this file byte-for-byte.
crates/core/licenses/THIRD-PARTY-CRATES.txt -text

*.png binary
*.ico binary
*.ttf binary
*.otf binary
*.webp binary
*.webm binary
*.gif binary
*.jpg binary
*.tgs binary
