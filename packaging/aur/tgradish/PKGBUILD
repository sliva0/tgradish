# Maintainer: sliva0 <sliva0mk at gmail dot com>

pkgname=tgradish
pkgver=2.1.1
pkgrel=1
pkgdesc='Telegram stickers and emoji from videos, images or pixel art'
arch=(x86_64 aarch64)
url='https://github.com/sliva0/tgradish'
# tgradish is MIT, with libwebp (BSD-3-Clause); the GUI's fonts: Ubuntu (Ubuntu
# Font Licence 1.0), JetBrains Mono (OFL-1.1), emoji-icon-font (MIT).
license=(MIT BSD-3-Clause Ubuntu-font-1.0 OFL-1.1)
# Runs external ffmpeg; the GUI dlopens graphics libraries and D-Bus for file
# dialogues at runtime. Keep in sync with GUI_LIBRARIES in xtask/src/package.rs,
# which documents where each comes from.
depends=(
  dbus
  ffmpeg
  gcc-libs
  glibc
  libglvnd
  libx11
  libxcb
  libxcursor
  libxi
  libxkbcommon
  libxkbcommon-x11
  libxrender
  wayland
)
makedepends=(cargo)
# makepkg's `lto` adds -flto=auto to CFLAGS, producing GCC LTO objects for
# libwebp-sys that rust-lld cannot link (failing with undefined WebP symbols).
# Cargo's release profile handles LTO for Rust code instead.
options=(!lto)
optdepends=('xdg-desktop-portal: file dialogues in the GUI')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

_cargo_env() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Strip local build paths from panic messages.
  export RUSTFLAGS="$RUSTFLAGS --remap-path-prefix=$srcdir=/"
}

prepare() {
  cd "$pkgname-$pkgver"
  _cargo_env
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  _cargo_env
  cargo build --frozen --release -p tgradish
}

# Run only tgradish-tgs's tests (pure Rust: no ffmpeg, subprocesses or
# signals); the full suite runs on Arch in the release workflow.
check() {
  cd "$pkgname-$pkgver"
  _cargo_env
  cargo test --frozen -p tgradish-tgs
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/tgradish -t "$pkgdir/usr/bin/"
  # Generate man pages (compressed by makepkg) and shell completions.
  target/release/tgradish __man "$srcdir/man"
  install -Dm644 "$srcdir"/man/*.1 -t "$pkgdir/usr/share/man/man1/"
  target/release/tgradish completions bash \
    | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/tgradish"
  target/release/tgradish completions zsh \
    | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_tgradish"
  target/release/tgradish completions fish \
    | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/tgradish.fish"
  target/release/tgradish completions nushell \
    | install -Dm644 /dev/stdin "$pkgdir/usr/share/nushell/vendor/autoload/tgradish.nu"
  install -Dm644 crates/cli/assets/tgradish.desktop -t "$pkgdir/usr/share/applications/"
  for icon in crates/cli/assets/icons/hicolor/*/apps/tgradish.png; do
    install -Dm644 "$icon" "$pkgdir/usr/share/${icon#crates/cli/assets/}"
  done
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # libwebp licence and patent grant.
  for file in COPYING PATENTS; do
    install -Dm644 "crates/core/licenses/libwebp/$file" \
      "$pkgdir/usr/share/licenses/$pkgname/libwebp-$file"
  done
  # Bundled GUI font licences (matches FONT_LICENCES in xtask/src/package.rs).
  install -Dm644 crates/gui/assets/fonts/Ubuntu-LICENCE.txt \
    crates/gui/assets/fonts/JetBrainsMono-OFL.txt \
    crates/gui/assets/fonts/emoji-icon-font-LICENSE.txt \
    -t "$pkgdir/usr/share/licenses/$pkgname/"
}
