// Embed the versioned Windows manifest (24 = RT_MANIFEST, generated by build.rs
// in OUT_DIR) and the Explorer application icon (generated by
// `cargo xtask icons`).
1 24 "tgradish.versioned.manifest"
1 ICON "assets/tgradish.ico"

// Version metadata for Windows Explorer's Details tab (read from here, not from
// the manifest). build.rs defines the TGRADISH_* macros from Cargo.toml's
// version. Numeric constants match winver.h (1 = VS_VERSION_INFO,
// 0x40004 = VOS_NT_WINDOWS32, 0x1 = VFT_APP; 040904b0 and 0x409, 1200 indicate
// US English / Unicode) so no system header is required.
#define TGRADISH_TEXT_(words) #words
#define TGRADISH_TEXT(words) TGRADISH_TEXT_(words)

1 VERSIONINFO
FILEVERSION TGRADISH_MAJOR, TGRADISH_MINOR, TGRADISH_PATCH, 0
PRODUCTVERSION TGRADISH_MAJOR, TGRADISH_MINOR, TGRADISH_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "tgradish"
      VALUE "ProductName", "tgradish"
      VALUE "FileVersion", TGRADISH_TEXT(TGRADISH_VERSION)
      VALUE "ProductVersion", TGRADISH_TEXT(TGRADISH_VERSION)
      VALUE "LegalCopyright", "Copyright (c) 2022 sliva0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
