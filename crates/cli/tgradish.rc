// tgradish.exe's manifest (24 is RT_MANIFEST) with its version written in,
// which build.rs leaves in OUT_DIR, and the icon Explorer shows for it,
// made by `cargo xtask icons`
1 24 "tgradish.versioned.manifest"
1 ICON "assets/tgradish.ico"

// The version Explorer shows on the Details tab, which it reads from here
// and not from the manifest. build.rs defines the TGRADISH_ names from
// Cargo.toml's version. Numbers stand for the names of winver.h, so no
// header has to be found: 1 is VS_VERSION_INFO, 0x40004 VOS_NT_WINDOWS32
// and 0x1 VFT_APP; 040904b0 and 0x409, 1200 both say US English in Unicode.
#define TGRADISH_TEXT_(words) #words
#define TGRADISH_TEXT(words) TGRADISH_TEXT_(words)

1 VERSIONINFO
FILEVERSION TGRADISH_MAJOR, TGRADISH_MINOR, TGRADISH_PATCH, 0
PRODUCTVERSION TGRADISH_MAJOR, TGRADISH_MINOR, TGRADISH_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "tgradish"
      VALUE "ProductName", "tgradish"
      VALUE "FileVersion", TGRADISH_TEXT(TGRADISH_VERSION)
      VALUE "ProductVersion", TGRADISH_TEXT(TGRADISH_VERSION)
      VALUE "LegalCopyright", "Copyright (c) 2022 sliva0, MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
